<Page
    x:Class="Ncrust.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      设置（对应 Android UserScreen 的「我的」页：资料 + 设置）。版式参考 Groove Music 设置页：
      左对齐单列、分组标题、限宽 720；控件一律用平台原生（ComboBox / ToggleSwitch / RadioButton / ContentDialog）。
      Android 独有的「后台运行（电池白名单）」不移植；「显示语言」等 i18n（M3）落地后再加。
      NavigationCacheMode=Required：从均衡器子页返回时保留滚动位置。
    -->
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="24,16,24,32"
            HorizontalAlignment="Left"
            Spacing="8">
            <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="设置" />

            <!-- 音质偏好 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="音质偏好" />
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="取不到所选音质时会自动逐级降低。Windows 按网络是否「按流量计费」区分两档（对应手机端的 WLAN / 移动数据）。"
                TextWrapping="Wrap"
                TextTrimming="None" />
            <ComboBox
                x:Name="WifiQualityBox"
                MinWidth="240"
                Header="不计费网络（Wi-Fi、有线）"
                SelectionChanged="WifiQualityChanged" />
            <ComboBox
                x:Name="MeteredQualityBox"
                MinWidth="240"
                Margin="0,8,0,0"
                Header="按流量计费的网络"
                SelectionChanged="MeteredQualityChanged" />

            <!-- 播放 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="播放" />
            <ToggleSwitch
                x:Name="TranslationSwitch"
                Header="歌词翻译"
                Toggled="TranslationToggled" />

            <!-- 非会员遇到 VIP 歌曲（对应 Android trialSettingTitle）：网易只给 45 秒试听片段。 -->
            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="非会员遇到 VIP 歌曲" />
            <StackPanel>
                <RadioButton
                    x:Name="TrialPlayRadio"
                    Checked="TrialModeChecked"
                    Content="播放试听片段"
                    GroupName="VipTrial"
                    Tag="play" />
                <RadioButton
                    x:Name="TrialSkipRadio"
                    Checked="TrialModeChecked"
                    Content="直接跳过"
                    GroupName="VipTrial"
                    Tag="skip" />
            </StackPanel>

            <!-- 无缝播放：1.0.2 起默认关闭，降级为实验特性，故排在「播放」分组最后一位
                 （对应 Android 1.4.0 的同款处置）。 -->
            <ToggleSwitch
                x:Name="GaplessSwitch"
                Margin="0,12,0,0"
                Header="无缝播放"
                Toggled="GaplessToggled" />
            <TextBlock
                Margin="0,-4,0,0"
                Style="{StaticResource CaptionTextStyle}"
                Text="提前加载下一首，消除曲间空白" />
            <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource CaptionTextStyle}"
                Foreground="{ThemeResource KPrimaryBrush}"
                Text="测试中，可能不稳定" />

            <!-- 托盘 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="托盘" />
            <ToggleSwitch
                x:Name="CloseToTraySwitch"
                Header="关闭窗口时最小化到托盘"
                Toggled="CloseToTrayToggled" />
            <TextBlock
                Margin="0,-4,0,0"
                Style="{StaticResource CaptionTextStyle}"
                Text="关闭后继续在托盘播放；从托盘菜单退出才会真正退出（退出不保留播放进度）。" />

            <!-- 网络 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="网络" />
            <ToggleSwitch
                x:Name="ProxySwitch"
                Header="使用系统代理"
                OffContent="直连（默认）"
                OnContent="走系统代理"
                Toggled="ProxyToggled" />
            <TextBlock
                x:Name="ProxyHint"
                Margin="0,-4,0,0"
                Style="{StaticResource CaptionTextStyle}"
                Text="默认直连，避免代理干扰音乐流导致播放异常；开关在重启后生效。"
                TextWrapping="Wrap"
                TextTrimming="None"
                Visibility="Collapsed" />

            <!-- 音效 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="音效" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Click="EqualizerClick">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="均衡器" />
                        <TextBlock x:Name="EqualizerSummary" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Glyph="&#xE76C;" />
                </Grid>
            </Button>

            <!-- 外观 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="外观" />
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="主题模式" />
            <StackPanel>
                <RadioButton
                    x:Name="ThemeSystemRadio"
                    Checked="ThemeChecked"
                    Content="跟随系统"
                    GroupName="Theme"
                    Tag="System" />
                <RadioButton
                    x:Name="ThemeDarkRadio"
                    Checked="ThemeChecked"
                    Content="深色"
                    GroupName="Theme"
                    Tag="Dark" />
                <RadioButton
                    x:Name="ThemeLightRadio"
                    Checked="ThemeChecked"
                    Content="浅色"
                    GroupName="Theme"
                    Tag="Light" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="强调色" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Rectangle
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource KPrimaryBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="跟随 Windows 的强调色" />
                <HyperlinkButton
                    VerticalAlignment="Center"
                    Click="OpenColorSettingsClick"
                    Content="更改 Windows 颜色设置" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="背景材质" />
            <ComboBox
                x:Name="BackdropBox"
                MinWidth="240"
                Header="侧边栏与主界面的背景"
                SelectionChanged="BackdropChanged">
                <ComboBoxItem Content="纯色（默认）" Tag="none" />
                <ComboBoxItem Content="亚克力" Tag="acrylic" />
                <ComboBoxItem Content="云母" Tag="mica" />
            </ComboBox>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="深色黑度" />
            <ComboBox
                x:Name="DarkStyleBox"
                MinWidth="240"
                Header="深色模式的底色"
                SelectionChanged="DarkStyleChanged">
                <ComboBoxItem Content="纯黑（默认）" Tag="black" />
                <ComboBoxItem Content="浅黑" Tag="soft" />
            </ComboBox>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="窗口圆角" />
            <ComboBox
                x:Name="CornerBox"
                MinWidth="240"
                Header="Windows 11 窗口圆角（Windows 10 不显示）"
                SelectionChanged="CornerChanged">
                <ComboBoxItem Content="圆角（系统默认）" Tag="round" />
                <ComboBoxItem Content="直角" Tag="square" />
            </ComboBox>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="歌词页" />
            <ComboBox
                x:Name="LyricsWidthBox"
                MinWidth="240"
                Header="歌词栏宽度（不同窗口比例下保持文字完整）"
                SelectionChanged="LyricsWidthChanged">
                <ComboBoxItem Content="窄（480）" Tag="narrow" />
                <ComboBoxItem Content="标准（640，默认）" Tag="standard" />
                <ComboBoxItem Content="宽（840）" Tag="wide" />
            </ComboBox>

            <!-- 存储与缓存 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="存储与缓存" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CacheSizeText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextStyle}"
                    Text="缓存占用 计算中…" />
                <Button
                    x:Name="ClearCacheButton"
                    Grid.Column="1"
                    Click="ClearCacheClick"
                    Content="清除缓存" />
            </Grid>
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="包括图片、歌词与页面缓存；不会清除登录状态、音乐库与播放队列。"
                TextWrapping="Wrap"
                TextTrimming="None" />

            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="下载目录" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="DownloadPathText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Click="PickDownloadPathClick"
                    Content="更改" />
            </Grid>
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="右键歌曲 → 下载 时保存到这里。" />

            <!-- 关于 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="关于" />
            <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextStyle}" />
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="网易云音乐第三方客户端。仅供学习交流使用，请支持正版音乐。"
                TextWrapping="Wrap"
                TextTrimming="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
