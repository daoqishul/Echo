<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ncrust for Windows —— WinUI 3（Windows App SDK）移植版，非打包（unpackaged）运行。
    从参考仓库 windows/（UWP + WinUI 2）移植；协议/加密/队列等业务逻辑原样复用 Ncrust.Core。
    构建：dotnet build -c Release   →   bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\Ncrust.exe
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Ncrust</RootNamespace>
    <AssemblyName>Echo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 自带 Windows App SDK 运行时，目标机无需安装 WASDK Runtime。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationTitle>Echo</ApplicationTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
    <AssemblyTitle>Echo</AssemblyTitle>
    <AssemblyDescription>网易云音乐第三方客户端 Echo（WinUI 3）</AssemblyDescription>
    <AssemblyCompany>Takahashi Rinta</AssemblyCompany>
    <AssemblyProduct>Echo</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2026 Takahashi Rinta</AssemblyCopyright>
    <!-- 应用图标与资源走 resources.pri；构建期生成到输出目录。 -->
    <EnableDefaultPriItems>true</EnableDefaultPriItems>
    <!-- exe / 任务栏 / Alt-Tab 图标：多尺寸 .ico（16~256，PNG 压缩）。
         非打包应用的窗口与任务栏图标都取自 exe 资源，改图标只需替换 Assets\app.ico 后重新构建。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 托盘图标（纯 Win32 P/Invoke 实现，不引入 WinForms/WPF）：作为松散文件随输出分发。 -->
  <ItemGroup>
    <Content Include="Assets\tray.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <!-- 登录窗口的内嵌 WebView2（WinUI 3 控件）。
         版本必须与 WASDK 1.8 内置的 WebView2 适配层匹配（WinUI 包依赖 1.0.3179.45），
         用更新的 SDK 会让 XAML 编译器在解析 WebView2 控件时崩溃（WMC9999）。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <!-- 本地生成登录二维码（纯托管，QRCoder）。 -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- DPAPI（ProtectedData）：非打包应用的登录凭据加密存储。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- 本地音乐标签读取（ID3 / FLAC / M4A）。 -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ncrust.Core\Ncrust.Core.csproj" />
    <ProjectReference Include="..\Ncrust.Audio\Ncrust.Audio.csproj" />
    <ProjectReference Include="..\Kanesumi.Xaml\Kanesumi.Xaml.csproj" />
  </ItemGroup>

</Project>
