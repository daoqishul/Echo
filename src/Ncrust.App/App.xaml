<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ncrust.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Ncrust.Resources">

    <!--
      资源装配。顺序不能反：Kanesumi 必须排在 XamlControlsResources 之后，
      否则它的圆角归零等覆盖盖不住 WinUI 的默认值。

      注：WASDK 1.8 已移除 ControlsResourcesVersion（Version1 老样式不再提供），
      统一用当前 WinUI 3 样式，再由 Kanesumi 的资源覆盖压回直角、纯色面板。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Kanesumi.Xaml/Themes/Kanesumi.xaml" />
                <resources:Templates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
