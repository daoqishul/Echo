<ResourceDictionary
    x:Class="Ncrust.Resources.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:Ncrust.Core.Api"
    xmlns:local="using:Ncrust.Resources"
    xmlns:player="using:Ncrust.Player"
    xmlns:shell="using:Ncrust.Shell">

    <!--
      全应用共用的列表项模板（x:Bind 编译绑定，所以本字典带 x:Class 与代码隐藏）。
      在 App.xaml 里排在 Kanesumi 之后合并；模板内容是延迟实例化的，里面的 StaticResource
      在实例化时沿元素树 → 应用资源查找，能找到 Kanesumi 的样式。
    -->

    <!--
      传输栏图标按钮（播放 / 暂停 / 切歌 / 模式 / 音量 / 队列）：
      自绘模板保证悬停高亮铺满整个按钮（平台默认样式只覆盖内容区一半），
      深色模式用更强的白色光泽（悬停 18% / 按下 27%），浅色模式用淡黑。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TransportButtonHoverBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="TransportButtonPressedBrush" Color="#45FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TransportButtonHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="TransportButtonPressedBrush" Color="#22000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="TransportIconButtonStyle" TargetType="AppBarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource KOnBackgroundBrush}" />
        <Setter Property="LabelPosition" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="AppBarButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverLayer"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverLayer"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressLayer"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverLayer"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressLayer"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="HoverLayer"
                            Background="{ThemeResource TransportButtonHoverBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Opacity="0" />
                        <Border
                            x:Name="PressLayer"
                            Background="{ThemeResource TransportButtonPressedBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Opacity="0" />
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}"
                            Foreground="{TemplateBinding Foreground}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 歌曲行：72 封面贴左边（Kanesumi 无边框贴边），标题 / 歌手，右侧时长。 -->
    <DataTemplate x:Key="SongRowTemplate" x:DataType="api:SongItem">
        <Grid Height="72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Source="{x:Bind local:DisplayFormat.Cover(CoverUrl, 144)}"
                Stretch="UniformToFill" />
            <StackPanel
                Grid.Column="1"
                Margin="12,0"
                VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Name}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind ArtistText}" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextStyle}"
                Text="{x:Bind DurationText}" />
        </Grid>
    </DataTemplate>

    <!-- 专辑磁贴：160 方形封面 + 两行文字（Groove / Apple Music 的专辑墙）。 -->
    <DataTemplate x:Key="AlbumTileTemplate" x:DataType="api:AlbumSearchItem">
        <StackPanel Width="176">
            <Image
                Width="176"
                Height="176"
                Source="{x:Bind local:DisplayFormat.Cover(PicUrl, 352)}"
                Stretch="UniformToFill" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Artist.Name}" />
        </StackPanel>
    </DataTemplate>

    <!-- 歌单磁贴：160 方形封面 + 最多两行标题。 -->
    <DataTemplate x:Key="PlaylistTileTemplate" x:DataType="api:PlaylistCard">
        <StackPanel Width="176">
            <Image
                Width="176"
                Height="176"
                Source="{x:Bind local:DisplayFormat.Cover(CoverUrl, 352)}"
                Stretch="UniformToFill" />
            <TextBlock
                Margin="0,8,0,0"
                MaxLines="2"
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind Name}"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- 歌手页的专辑磁贴：封面 + 名称 + 年份与曲数（对应 Android ArtistAlbumGridItem）。 -->
    <DataTemplate x:Key="ArtistAlbumTileTemplate" x:DataType="api:ArtistAlbumItem">
        <StackPanel Width="176">
            <Image
                Width="176"
                Height="176"
                Source="{x:Bind local:DisplayFormat.Cover(PicUrl, 352)}"
                Stretch="UniformToFill" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind local:DisplayFormat.AlbumYearAndCount(PublishTime, Size)}" />
        </StackPanel>
    </DataTemplate>

    <!-- 音乐库的专辑磁贴：封面 + 名称 + 歌手与曲数（对应 Android LibraryAlbumGridItem）。 -->
    <DataTemplate x:Key="CloudAlbumTileTemplate" x:DataType="api:CloudAlbum">
        <StackPanel Width="176">
            <Image
                Width="176"
                Height="176"
                Source="{x:Bind local:DisplayFormat.Cover(PicUrl, 352)}"
                Stretch="UniformToFill" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind local:DisplayFormat.ArtistAndCount(Artist, SongCount)}" />
        </StackPanel>
    </DataTemplate>

    <!-- 音乐库的歌单磁贴：封面 + 名称 + 曲数（对应 Android PlaylistGridItem）。 -->
    <DataTemplate x:Key="UserPlaylistTileTemplate" x:DataType="api:UserPlaylistInfo">
        <StackPanel Width="176">
            <Image
                Width="176"
                Height="176"
                Source="{x:Bind local:DisplayFormat.Cover(CoverImgUrl, 352)}"
                Stretch="UniformToFill" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind local:DisplayFormat.TrackCount(TrackCount)}" />
        </StackPanel>
    </DataTemplate>

    <!-- 歌手行：72 头像贴左边，名字 / 专辑与歌曲数。 -->
    <DataTemplate x:Key="ArtistRowTemplate" x:DataType="api:ArtistSearchItem">
        <Grid Height="72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="72"
                Height="72"
                Source="{x:Bind local:DisplayFormat.Cover(PicUrl, 144)}"
                Stretch="UniformToFill" />
            <StackPanel
                Grid.Column="1"
                Margin="12,0"
                VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Name}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind local:DisplayFormat.ArtistCounts(AlbumSize, MusicSize)}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- 播放队列：分区标题（过去播放 / 现在播放 / 将要播放）。 -->
    <DataTemplate x:Key="QueueHeaderTemplate" x:DataType="player:QueueRow">
        <TextBlock
            Margin="0,16,0,6"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind Title}" />
    </DataTemplate>

    <!--
      播放队列的歌曲行：56 封面、标题 / 歌手、当前曲左侧 3px 强调色竖条、行尾移除。
      根元素的 DataContext 设成歌曲本身，歌曲右键菜单（按 DataContext 找 SongItem）才能认出这一行。
    -->
    <DataTemplate x:Key="QueueSongTemplate" x:DataType="player:QueueRow">
        <Grid Height="56" DataContext="{x:Bind Song}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Width="56"
                Height="56"
                Source="{x:Bind local:DisplayFormat.Cover(Song.CoverUrl, 112)}"
                Stretch="UniformToFill" />
            <Rectangle
                Width="3"
                HorizontalAlignment="Left"
                Fill="{ThemeResource KPrimaryBrush}"
                Visibility="{x:Bind CurrentMarkVisibility}" />
            <StackPanel
                Grid.Column="1"
                Margin="12,0"
                VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyTextStyle}"
                    Text="{x:Bind Song.Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{x:Bind Song.ArtistText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <AppBarButton
                Grid.Column="2"
                Width="40"
                Height="40"
                Margin="0,0,4,0"
                Click="QueueRemoveClick"
                Tag="{x:Bind QueueIndex}"
                ToolTipService.ToolTip="从队列移除"
                LabelPosition="Collapsed">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </Grid>
    </DataTemplate>

    <!-- INFINITY 模式的续播占位（对应 Android queueInfinityPlaceholder）。 -->
    <DataTemplate x:Key="QueuePlaceholderTemplate" x:DataType="player:QueueRow">
        <TextBlock
            Margin="0,12"
            Style="{StaticResource CaptionTextStyle}"
            Text="{x:Bind Title}" />
    </DataTemplate>

    <player:QueueRowTemplateSelector
        x:Key="QueueRowTemplateSelector"
        HeaderTemplate="{StaticResource QueueHeaderTemplate}"
        PlaceholderTemplate="{StaticResource QueuePlaceholderTemplate}"
        SongTemplate="{StaticResource QueueSongTemplate}" />

    <!--
      搜索框下拉项：左侧 40 小封面（搜过的关键词、「清除搜索记录」没有封面，显示图标），
      右侧标题 + 副标题（歌手 / 「专辑 · 歌手」等）。
    -->
    <DataTemplate x:Key="SearchSuggestionTemplate" x:DataType="shell:SearchSuggestion">
        <Grid Padding="0,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AppBarButton
                Grid.Column="2"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Click="SuggestionDeleteClick"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="删除记录"
                Visibility="{x:Bind DeleteVisibility}">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <Grid
                Width="40"
                Height="40"
                Background="{ThemeResource KSurfaceVariantBrush}"
                Visibility="{x:Bind CoverVisibility}">
                <Image Source="{x:Bind local:DisplayFormat.Cover(CoverUrl, 80)}" Stretch="UniformToFill" />
            </Grid>
            <FontIcon
                Width="40"
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                Glyph="{x:Bind Glyph}"
                Visibility="{x:Bind GlyphVisibility}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyTextStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{x:Bind Subtitle}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind SubtitleVisibility}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
